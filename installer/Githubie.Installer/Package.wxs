<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Githubie"
    Manufacturer="Akatsukisoft"
    Version="$(ProductVersion)"
    UpgradeCode="1A5C995A-0F3A-4A4B-B00D-8D9D9BAA6B57"
    Language="1041"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Description="Githubie GitHub MCP Server" />
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Githubie is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ROOTDRIVE" Value="C:\" Secure="yes" />
    <Property Id="INSTALLROOT" Secure="yes" />
    <Property Id="INSTALLROOT_REMEMBERED" Secure="yes">
      <RegistrySearch Id="InstallRootSearch" Root="HKLM" Key="SOFTWARE\Akatsukisoft\Githubie" Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLROOT" Value="[INSTALLROOT_REMEMBERED]" After="AppSearch" Sequence="both" Condition="NOT INSTALLROOT AND INSTALLROOT_REMEMBERED" />
    <Property Id="GITHUBIE_USER_SETUP_PENDING" Secure="yes" />
    <Property Id="GITHUBIE_TARGET_SID" Secure="yes" />
    <Launch Condition="Installed OR REMOVE = &quot;ALL&quot; OR (GITHUBIE_USER_SETUP_PENDING = &quot;1&quot; AND GITHUBIE_TARGET_SID)"
            Message="Run Install-UserHost.ps1 as the intended non-elevated signed-in user. MSI alone does not complete user startup setup." />

    <!-- Service mode: standalone by default; MOYAI=1 registers the service in Moyai integration mode (MOYAI=0 returns to standalone).
         The value is remembered in the registry so later upgrades keep the selected mode. -->
    <Property Id="MOYAI" Secure="yes" />
    <Property Id="MOYAI_REMEMBERED" Secure="yes">
      <RegistrySearch Id="MoyaiModeSearch" Root="HKLM" Key="SOFTWARE\Akatsukisoft\Githubie" Name="MoyaiIntegration" Type="raw" />
    </Property>
    <SetProperty Id="MOYAI" Value="[MOYAI_REMEMBERED]" After="AppSearch" Sequence="both" Condition="NOT MOYAI AND MOYAI_REMEMBERED" />
    <!-- DIRECT_UNRESTRICTED=1 (only with MOYAI=1) also lets header-less loopback clients use every repository tool.
         The value is remembered in the registry in the same way; DIRECT_UNRESTRICTED=0 turns it off. -->
    <Property Id="DIRECT_UNRESTRICTED" Secure="yes" />
    <Property Id="DIRECT_UNRESTRICTED_REMEMBERED" Secure="yes">
      <RegistrySearch Id="DirectUnrestrictedSearch" Root="HKLM" Key="SOFTWARE\Akatsukisoft\Githubie" Name="DirectUnrestricted" Type="raw" />
    </Property>
    <SetProperty Id="DIRECT_UNRESTRICTED" Value="[DIRECT_UNRESTRICTED_REMEMBERED]" After="AppSearch" Sequence="both" Condition="NOT DIRECT_UNRESTRICTED AND DIRECT_UNRESTRICTED_REMEMBERED" />
    <SetProperty Action="SetMoyaiSwitch" Id="GITHUBIE_MOYAI_SWITCH" Value=" --moyai" Before="InstallInitialize" Sequence="execute" Condition="MOYAI = &quot;1&quot; AND NOT DIRECT_UNRESTRICTED = &quot;1&quot;" />
    <SetProperty Action="SetMoyaiDirectUnrestrictedSwitch" Id="GITHUBIE_MOYAI_SWITCH" Value=" --moyai --direct-unrestricted" Before="InstallInitialize" Sequence="execute" Condition="MOYAI = &quot;1&quot; AND DIRECT_UNRESTRICTED = &quot;1&quot;" />

    <StandardDirectory Id="TARGETDIR">
      <Directory Id="INSTALLROOT" Name="Githubie" ComponentGuidGenerationSeed="8A814A4E-0993-471B-960C-461C01187CFD">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="CONFIGDIR" Name="config" />
        <Directory Id="LOGDIR" Name="logs" />
        <Directory Id="DATADIR" Name="data">
          <Directory Id="SECRETSDIR" Name="secrets" />
        </Directory>
        <Directory Id="DOCDIR" Name="docs">
          <Directory Id="REFERENCE_DOCS" Name="docs">
            <Directory Id="SPEC_DOCS" Name="specifications" />
            <Directory Id="ADR_DOCS" Name="adr" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Githubie" Level="1">
      <ComponentGroupRef Id="BinaryComponents" />
      <ComponentGroupRef Id="ConfigurationComponents" />
      <ComponentGroupRef Id="DataDirectoryComponents" />
      <ComponentGroupRef Id="DocumentationComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="BinaryComponents" Directory="BINDIR">
      <Component Id="ServerServiceComponent" Guid="*">
        <File Id="ServerExecutable" Source="$(PublishDir)\Githubie.Server.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Akatsukisoft\Githubie" Name="InstallRoot" Type="string" Value="[INSTALLROOT]" />
        <Environment
          Id="AddBinToPath"
          Name="PATH"
          Value="[BINDIR]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Akatsukisoft\Githubie"
          Name="MoyaiIntegration"
          Type="string"
          Value="[MOYAI]" />
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Akatsukisoft\Githubie"
          Name="DirectUnrestricted"
          Type="string"
          Value="[DIRECT_UNRESTRICTED]" />
        <ServiceControl
          Id="GithubieServiceControl"
          Name="Githubie"
          Stop="both"
          Remove="both"
          Wait="yes" />
      </Component>
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\Githubie.Server.exe" />
        <Exclude Files="$(PublishDir)\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ConfigurationComponents" Directory="CONFIGDIR">
      <Component Id="CanonicalConfigurationComponent" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <File Id="CanonicalConfiguration" Source="..\..\githubie.default.json" Name="githubie.json" KeyPath="yes" />
      </Component>
      <Component Id="ConfigurationTemplateComponent" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <File Id="ConfigurationTemplate" Source="..\..\githubie.example.json" Name="githubie.example.json" KeyPath="yes" />
        <CreateFolder>
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DataDirectoryComponents">
      <Component Id="LogDirectoryComponent" Directory="LOGDIR" Guid="A47D7110-9F3C-45ED-87E1-859B3F2D634A" Permanent="yes">
        <CreateFolder>
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
      <Component Id="DataDirectoryComponent" Directory="DATADIR" Guid="9185AE45-70E4-4E55-AD9D-F14534949F48" Permanent="yes">
        <CreateFolder>
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
      <Component Id="SecretsDirectoryComponent" Directory="SECRETSDIR" Guid="3D055657-6E9F-43F9-AA96-8F2C767FA1A9" Permanent="yes">
        <CreateFolder>
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DocumentationComponents" Directory="DOCDIR">
      <Component Id="PrPublicationContractDocumentation" Directory="SPEC_DOCS" Guid="5D75A327-58E9-4BC8-9E0B-CAAE9F06A463">
        <File Source="..\..\docs\specifications\pr-source-publication.md" />
        <File Source="..\..\docs\specifications\pr-source-publication.ja.md" />
      </Component>
      <Component Id="PrPublicationDecisionDocumentation" Directory="ADR_DOCS" Guid="1C074B23-D3B4-49C8-BB1A-994CC7DE76FA">
        <File Source="..\..\docs\adr\0046-pr-source-publication-integration.md" />
        <File Source="..\..\docs\adr\0047-pr-publication-source-allowlist.md" />
      </Component>
      <Component Id="PrMergeContractDocumentation" Directory="SPEC_DOCS" Guid="D659632C-C3C4-4C74-9F29-C425960EF4CD">
        <File Source="..\..\docs\specifications\pr-merge-provider.md" />
        <File Source="..\..\docs\specifications\pr-merge-provider.ja.md" />
      </Component>
      <Component Id="PrMergeDecisionDocumentation" Directory="ADR_DOCS" Guid="19B99C36-5080-4C29-87EB-AED588B9CE1E">
        <File Source="..\..\docs\adr\0043-pull-request-merge-provider.md" />
      </Component>
      <Component Id="BranchProtectionContractDocumentation" Directory="SPEC_DOCS" Guid="B807A17D-A4B5-41FD-9138-15D8D678CA37">
        <File Source="..\..\docs\specifications\github-branch-protection.md" />
        <File Source="..\..\docs\specifications\github-branch-protection.ja.md" />
      </Component>
      <Component Id="BranchProtectionDecisionDocumentation" Directory="ADR_DOCS" Guid="C99D694F-6EED-41B0-B723-2F93D292A46E">
        <File Source="..\..\docs\adr\0044-github-branch-protection.md" />
      </Component>
      <Component Id="DocumentationComponent" Guid="8E570EE6-DF3F-48B0-BEE8-87EC77E8C615">
        <File Source="..\..\README.md" />
        <File Source="..\..\README.ja.md" />
        <File Source="..\..\DOCUMENTS.md" />
        <File Source="..\..\DOCUMENTS.ja.md" />
        <File Source="..\..\MCP_SETUP.md" />
        <File Source="..\..\MCP_SETUP.ja.md" />
        <File Source="..\..\USER_HOST.md" />
        <File Source="..\..\USER_HOST.ja.md" />
        <File Source="..\..\docs\licenses\Tomlyn.txt" Name="Tomlyn.LICENSE.txt" />
        <File Source="..\..\INSTALLATION.md" />
        <File Source="..\..\INSTALLATION.ja.md" />
        <File Source="..\..\OPERATIONS.md" />
        <File Source="..\..\OPERATIONS.ja.md" />
        <File Source="..\..\TROUBLESHOOTING.md" />
        <File Source="..\..\TROUBLESHOOTING.ja.md" />
        <File Source="..\..\CONFIG.md" />
        <File Source="..\..\CONFIG.ja.md" />
        <File Source="..\..\COMMANDS.md" />
        <File Source="..\..\COMMANDS.ja.md" />
        <File Source="..\..\SECURITY.md" />
        <File Source="..\..\SECURITY.ja.md" />
        <File Source="..\..\PACKAGES.md" />
        <File Source="..\..\PACKAGES.ja.md" />
        <File Source="..\..\RELEASE.md" />
        <File Source="..\..\RELEASE.ja.md" />
        <File Source="..\..\LICENSE" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
