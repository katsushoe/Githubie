<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- ログオン時の自動起動でコンソールウィンドウを出さないため、GUIサブシステムでビルドする。ログはDailyFileLoggerProviderでlogsへ出力する。 -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>Githubie MCP Server</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moyai.ProviderAuthentication" Version="1.0.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Githubie.Application/Githubie.Application.csproj" />
    <ProjectReference Include="../Githubie.Infrastructure/Githubie.Infrastructure.csproj" />
    <ProjectReference Include="../Githubie.AskPass/Githubie.AskPass.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Githubie.Server.Tests" />
    <EmbeddedResource Include="ApplyStartupUpdate.ps1" />
    <EmbeddedResource Include="../../assets/githubie.ico" LogicalName="Githubie.Icon.ico" />
    <Compile Include="../Shared/ApplicationIcon.cs" Link="ApplicationIcon.cs" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
