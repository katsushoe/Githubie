{
  "mcp_port": 45460,
  "mcp_path": "/mcp",
  "provider_authentication": {
    "issuer": "moyai:instance-01",
    "trust_bundle_path": "C:\\Githubie\\config\\moyai-trust.json",
    "replay_database_path": "C:\\Githubie\\data\\moyai-replay.db",
    "projects": {
      "example": "11111111-1111-1111-1111-111111111111"
    },
    "protocol_version": "1",
    "assertion_lifetime_seconds": 120,
    "clock_skew_seconds": 30
  },
  "repositories": {
    "example": {
      "github_owner": "example-org",
      "github_repo": "example-repository",
      "local_root": "D:\\Projects\\ExampleRepository",
      "remote": "origin",
      "develop_branch": "develop",
      "main_branch": "main",
      "direct_push_branches": ["develop"],
      "pull_branches": ["develop", "main"],
      "protected_branches": ["main"],
      "tag_target_branch": "main",
      "tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+.*$",
      "merge_method": "merge",
      "require_clean_working_tree": true,
      "workflows": {
        "release.yml": {
          "allowed_refs": ["main"],
          "inputs": {
            "version": { "type": "string", "required": true, "max_length": 32, "secret": false }
          },
          "max_concurrent": 1,
          "correlation_timeout_seconds": 15
        }
      }
    }
  }
}
