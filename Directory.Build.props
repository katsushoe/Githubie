<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>13</LangVersion>
    <Version>2.2.4.1</Version>
    <AssemblyVersion>2.2.4.1</AssemblyVersion>
    <FileVersion>2.2.4.1</FileVersion>
    <InformationalVersion>2.2.4.1</InformationalVersion>
    <Company>Akatsukisoft</Company>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Githubie.Server' Or '$(MSBuildProjectName)' == 'Githubie.ApprovalPrompt' Or '$(MSBuildProjectName)' == 'Githubie.Cli' Or '$(MSBuildProjectName)' == 'Githubie.McpClient' Or '$(MSBuildProjectName)' == 'Githubie.AskPass'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\githubie.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
